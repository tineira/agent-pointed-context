{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pulse for the APC standard (TIN-382): its own Worker (apc-pulse, TIN-605), sandboxes and domain, with pairing from an
  // agent dock's hub turned on. This app no longer builds V1: V1 is frozen in apps/v1 (Worker apc-demo,
  // apc.tineira.com/v1, TIN-604). Since TIN-605 the Worker is apc-pulse, at pulse.apc.tineira.com, with fresh
  // Durable Objects (the first deploy creates them from the migrations) and fresh rate limit namespaces.
  "name": "apc-pulse",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*", "/apc/*", "/.well-known/*"]
  },
  // APC_PROFILES (APC 0.3, TIN-578) is the one place Pulse declares how agents reach it: Direct (its own MCP URL
  // per agent, made on the Agents screen) and Dock (dropped from a dock's hub). One of them alone works too.
  "vars": { "APC_V2": "1", "HUB_ORIGINS": "https://apc.tineira.com", "APC_PROFILES": "direct,dock" },
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  // New sandboxes per IP, and calls per sandbox (the page and its agents together). Periods are 10 or 60 s.
  "ratelimits": [
    { "name": "NEW_SANDBOX", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "SANDBOX_CALLS", "namespace_id": "1008", "simple": { "limit": 300, "period": 60 } }
  ],
  "routes": [{ "pattern": "pulse.apc.tineira.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
