{
  "$schema": "node_modules/wrangler/config-schema.json",
  // V1, frozen (TIN-604): the paper's demo at apc.tineira.com/v1. The same Worker as before the move
  // (name apc-demo), so its Durable Objects, the ANALYTICS_SALT secret and the analytics dataset carry over.
  "name": "apc-demo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The page and its files sit under v1/ in the assets directory (vite.config.ts), so /v1/favicon.svg is
    // the file v1/favicon.svg and nothing is served outside /v1. A request that matches no file reaches the
    // Worker (not_found_handling stays "none", the default): / and /v1 redirect to /v1/, an app route under
    // /v1/ gets v1/index.html from the Worker, the rest is a 404. No base_path: it is not available on every
    // account (code 100343 on the first deploy).
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/api", "/v1/api/*", "/v1/mcp", "/v1/mcp/*", "/v1/apc", "/v1/apc/*", "/v1/.well-known", "/v1/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  // New sandboxes per IP, and calls per sandbox (the page and its agents together). Periods are 10 or 60 s.
  "ratelimits": [
    { "name": "NEW_SANDBOX", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SANDBOX_CALLS", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Distinct MCP agent sessions (TIN-347). Written only with the ANALYTICS_SALT secret set; read by scripts/mcp-sessions.mjs.
  "analytics_engine_datasets": [{ "binding": "MCP_SESSIONS", "dataset": "apc_mcp_sessions" }],
  "routes": [{ "pattern": "apc.tineira.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
