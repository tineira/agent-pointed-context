{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APC Dock",
  "version": "0.1.0",
  "identifier": "com.tineira.apc.dock",
  "build": {
    "frontendDist": "https://v2.apc.tineira.com/dock?shell=desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Your agents, on top of every window",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
