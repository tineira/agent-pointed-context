{
  "manifest_version": 3,
  "name": "APC: point your agent at any page",
  "short_name": "APC",
  "version": "0.1.0",
  "description": "Drop the agent from your APC dock on a page you allow, and it reads what you pointed at.",
  "key": "",
  "minimum_chrome_version": "122",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://v2.apc.tineira.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "APC",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon-32.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "commands": {
    "open-dock": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open your APC dock"
    },
    "float": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open your dock ready to float your agents"
    }
  }
}
