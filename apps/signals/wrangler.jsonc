{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Signals (TIN-384): the second APC app, a market feed, on its own origin. One Durable Object per
  // visitor, on the world their dock opened it on (or one of its own). Agents reach it both ways
  // (TIN-578): directly, each on its own MCP URL, and through a dock's hub.
  "name": "apc-signals",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*", "/apc/*", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FEED", "class_name": "Feed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }],
  "ratelimits": [
    { "name": "NEW_FEED", "namespace_id": "1009", "simple": { "limit": 10, "period": 60 } },
    { "name": "FEED_CALLS", "namespace_id": "1010", "simple": { "limit": 300, "period": 60 } }
  ],
  // The agent docks (hubs) Signals may pair with; under vite dev, localhost too. APC_PROFILES is the one
  // place Signals declares how agents reach it (APC 0.4): Direct, Dock, or both.
  "vars": { "HUB_ORIGINS": "https://apc.tineira.com", "PUBLIC_ORIGIN": "https://signals.apc.tineira.com", "APC_PROFILES": "direct,dock" },
  "routes": [{ "pattern": "signals.apc.tineira.com", "custom_domain": true }],
  "workers_dev": true,
  // No invocation logs (TIN-911): they record each request URL, and an agent's or a grant's MCP URL holds its secret.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
