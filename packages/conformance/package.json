{
  "name": "@tineira/apc-conformance",
  "version": "0.12.0",
  "description": "Agent Pointed Context (APC) conformance: checks an app against the standard, in process with an adapter, or live over HTTP with the apc-conformance command.",
  "keywords": ["apc", "agent-pointed-context", "mcp", "model-context-protocol", "ai-agents", "conformance", "testing"],
  "homepage": "https://apc.tineira.com/docs",
  "bugs": { "url": "https://github.com/tineira/agent-pointed-context/issues" },
  "repository": { "type": "git", "url": "https://github.com/tineira/agent-pointed-context", "directory": "packages/conformance" },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workers": "./src/workers.ts"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=22.15" },
  "scripts": {
    "prepack": "node ../../scripts/check-packages.mjs --dist"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./workers": { "types": "./dist/workers.d.ts", "import": "./dist/workers.js" }
    },
    "types": "./dist/index.d.ts",
    "bin": { "apc-conformance": "./dist/cli.js" }
  },
  "dependencies": {
    "@tineira/apc-protocol": "workspace:^"
  }
}
